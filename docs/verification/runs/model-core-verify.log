==============================================================================
[A] 构造链与配置键消耗
==============================================================================
audionet_name = FalconSpeakerContrastive
config keys(depth1) = ['n_src', 'pretrained_vout_chan', 'causal', 'spk_embed_dim', 'video_bn_params', 'audio_bn_params', 'enc_dec_params', 'audio_params', 'video_params', 'fusion_params', 'mask_generation_params']
构造后 Falcon.audio_params keys = ['act_type', 'causal', 'hid_chan', 'is2d', 'kernel_size', 'layers', 'n_freqs', 'norm_type', 'stride', 'upsampling_depth']
  -> 'repeats' still in model.audio_params?  False
  -> 'shared'  still in model.audio_params?  False
  -> 'causal' in model.audio_params?        True
  -> 'repeats' still in model.video_params? False
separator.fusion_repeats / audio_repeats = 1 1
separator.audio_shared/video_shared/fusion_shared = True True True
audio_net type = AudioBlock | video_net type = VideoBlock | caf type = NeuroSCNetFusion
mdcl_margin/mdcl_alpha = 0.0 0.15
spk_embed_dim = 64 | n_src = 1 | causal = True
传入的 config dict 是否被构造函数 pop 改写: False (True=被 pop 掉，同一 dict 不能复用)

